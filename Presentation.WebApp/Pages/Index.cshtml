@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="d-flex">
        <div class=" me-auto fs-3">Projects</div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">+ Add Project</button>
        <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true" id="addModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header p-5 pb-4 border-bottom-0">
                <h1 class="mb-0 fs-2">Add Project</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-5 pt-0">
                <div class="d-flex p-5">
                    <img src="images/Image.svg" class="mx-auto" style="height: 160px;" alt="Project image"/>
                </div>
                <form method="post">
                    <div class="form-label mb-3">
                        <label for="projectName">Project Name</label>
                        <input type="text" class="form-control rounded-3" id="projectName" asp-for="@Model.FormData.Name">
                    </div>
                    <div class="form-label mb-3">
                        <label for="clientName">Client Name</label>
                        <input type="text" class="form-control rounded-3" id="clientName" asp-for="@Model.FormData.Customer">
                    </div>
                    <div class="form-label mb-3">
                        <label for="projectDescription">Description</label>
                        <input type="text" class="form-control rounded-3" id="projectDescription" asp-for="@Model.FormData.Description">
                    </div>
                    <div class="d-flex mb-3">
                        <div class="me-auto">
                            <label for="startDate">Start Date</label>
                            <input type="date" class="form-control rounded-3" id="startDate" asp-for="@Model.FormData.StartDate"/>
                        </div>
                        <div>
                            <label for="endDate">End Date</label>
                            <input type="date" class="form-control rounded-3" id="endDate" asp-for="@Model.FormData.EndDate"/>
                        </div>
                    </div>
                    <div class="form-label mb-3">
                        <label for="projectBudget">Budget</label>
                        <input type="number" class="form-control rounded-3" id="projectBudget" asp-for="@Model.FormData.Budget">
                    </div>
                    <div class="form-label mb-5">
                        <label for="projectStatus">Status</label>
                        <select id="projectStatus" class="form-select" asp-for="@Model.FormData.StatusId" asp-items="Model.StatusList">
                            <option hidden value="">Select a status</option>
                        </select>
                    </div>
                    <button class="w-100 mt-5 btn btn-lg rounded-3 btn-primary" asp-page-handler="create" type="submit" value="Save">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>
    </div>
    <div class="flex-row mt-4">
        <form method="post">
            <button class="btn" asp-page-handler="filterProjectsAll">All</button>
            <button class="btn" asp-page-handler="filterProjectsStarted">Started</button>
            <button class="btn" asp-page-handler="filterProjectsCompleted">Completed</button>
        </form>
    </div>
</div>

<div class="container-fluid ms-4">
    <div class="row row-cols-sm-3 row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var project in Model.ProjectsList)
        {
            <div class="card m-2 mt-4 p-3" style="width: 22rem;">
                <form method="post">
                    <div class="d-flex flex-row">
                        <div class="col-2 me-4 m-2">
                            <img src="images/Image.svg" style="width: 100px;" class="img-fluid rounded-start" alt="Project logo">
                        </div>
                        <div class="col-5 me-auto mt-2">
                            <h5 class="card-title">@project.Name</h5>
                            <p class="card-text">@project.Customer.Name</p>
                        </div>
                        <div class="col-2 dropdown">
                            <img src="images/More 2.svg" alt="Project options image" class="btn dropdown-toggle" data-bs-toggle="dropdown"/>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#editModal-@project.Id">Edit</button></li>
                                <li><button class="dropdown-item" type="submit" asp-page-handler="delete" asp-route-id="@project.Id">Delete Project</button></li>
                            </ul>
                        </div>
                    </div>
                </form>
                <div class="row mt-3">
                    <div class="card-text">
                        @project.Description
                    </div>
                </div>
            </div>
        
            <div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true" id="editModal-@project.Id">
                <div class="modal-dialog" role="document">
                    <div class="modal-content rounded-4 shadow">
                        <div class="modal-header p-5 pb-4 border-bottom-0">
                            <h1 class="mb-0 fs-2">Edit Project</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body p-5 pt-0">
                            <div class="d-flex p-5">
                                <img src="images/Image.svg" class="mx-auto" style="height: 160px;" alt="Project image"/>
                            </div>
                            <form method="post">
                                <div class="form-label mb-3">
                                    <label for="editProjectName">Project Name</label>
                                    <input type="text" class="form-control rounded-3" id="editProjectName" value="@project.Name" asp-for="@Model.FormData.Name">
                                </div>
                            
                                <div class="form-label mb-3">
                                    <label for="editClientName">Client Name</label>
                                    <input type="text" class="form-control rounded-3" id="editClientName" value="@project.Customer.Name" asp-for="@Model.FormData.Customer">
                                </div>
                            
                                <div class="form-label mb-3">
                                    <label for="editProjectDescription">Description</label>
                                    <input type="text" class="form-control rounded-3" id="editProjectDescription" value="@project.Description" asp-for="@Model.FormData.Description">
                                </div>
                            
                                <div class="d-flex mb-3">
                                    <div class="me-auto">
                                        <label for="editStartDate">Start Date</label>
                                        <input type="date" class="form-control rounded-3" id="editStartDate" value="@project.Dates.StartDate.ToString("yyyy-MM-dd")" asp-for="@Model.FormData.StartDate"/>
                                    </div>
                                    <div>
                                        <label for="editEndDate">End Date</label>
                                        <input type="date" class="form-control rounded-3" id="editEndDate" value="@project.Dates.EndDate.ToString("yyyy-MM-dd")" asp-for="@Model.FormData.EndDate"/>
                                    </div>
                                </div>
                            
                                <div class="form-label mb-3">
                                    <label for="editProjectBudget">Budget</label>
                                    <input type="text" class="form-control rounded-3" id="editProjectBudget" value="@project.Budget.BudgetAmount" asp-for="@Model.FormData.Budget">
                                </div>
                            
                                <div class="form-label mb-5">
                                    <label for="editProjectStatus">Status</label>
                                    <select id="editProjectStatus" class="form-select" asp-for="@Model.FormData.StatusId" asp-items="@Model.StatusList">
                                        <option hidden value="">Select a status</option>
                                    </select>
                                </div>
                                <button class="w-100 mt-5 btn btn-lg rounded-3 btn-primary" asp-page-handler="update" asp-route-id="@project.Id" type="submit" value="Save">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        
            // This code is generated by chatGPT
            <script>    
                
            document.addEventListener('DOMContentLoaded', function () {
            const modals = document.querySelectorAll('.modal');

            modals.forEach(modal => {
            modal.addEventListener('hidden.bs.modal', function () {
            // Reset all form fields inside this modal
            const form = modal.querySelector('form');
            if (form) form.reset();
            });
        });
    });

            </script>
        }
    </div>    
</div>




